<?xml version="1.0" encoding="utf-8"?>
<!--
  Cinderous 品牌火炭（ADR-0278）——自適應圖示的**前景層**。
  幾何與配色直接取自 `apps/desktop/src-tauri/icons/cinderous-ember.svg`（桌面版同一份設計），
  只是去掉背板：自適應圖示的底色由 background 層負責，圓角/圓形交給系統遮罩。

  viewport 用原稿的 1024 而非 108，路徑座標才能原封不動搬過來（少一次換算＝少一個出錯點）。
  安全區檢查：火焰下緣圓心約 (512,640)、半徑約 190 → 距圖示中心 128+190=318 < 338
  （＝66% 安全圈半徑）；尖端 y=200 距中心 312 < 338。任何遮罩都裁不到。

  漸層需 API 24+，故本檔放 drawable-v24；`drawable/` 另有純色版供 API 23 退化使用。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path android:pathData="M512 200C380 380 322 500 322 600C322 720 410 800 512 800C614 800 702 720 702 600C702 500 644 380 512 200Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="512"
                android:startY="200"
                android:endX="512"
                android:endY="800">
                <item android:offset="0" android:color="#E8531A" />
                <item android:offset="1" android:color="#FFAB3D" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FFD66B"
        android:pathData="M512 380C448 480 418 550 418 610C418 690 462 740 512 740C562 740 606 690 606 610C606 550 576 480 512 380Z" />
</vector>
